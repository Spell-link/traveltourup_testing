LIBRE_TRANSLATE_API_KEY=





# From Duffel Dashboard when creating a webhook (required for POST /api/v1/webhooks/duffel)
DUFFEL_WEBHOOK_SECRET=

# Flight checkout — Duffel PaymentIntent gross-up (see Duffel “Collecting customer card payments”).
FLIGHT_COMMISSION_PERCENT=5
FLIGHT_MARKUP_FIXED=0
# Assumed card fee for (fare+markup)/customer currency; domestic vs intl may differ — tune per Duffel dashboard.
DUFFEL_PAYMENTS_FEE_RATE=0.029
# 1 when customer pays in same currency as offer; otherwise mid-market × small buffer per Duffel guide.
FLIGHT_PAYMENT_FX_RATE=1
# Max drift between PaymentIntent snapshot and refreshed offer total (major units) before order.
FLIGHT_PRICE_TOLERANCE_MAJOR=2
# Default flight PSP (only duffel_payments implemented).
FLIGHT_PAYMENT_PROVIDER=duffel_payments

# --- Stripe (hotel/car checkout — customer pays TravelTourUp; Duffel Balance settles supplier) ---
# Create account: https://dashboard.stripe.com/register → Developers → API keys
# Publishable key (browser): pk_test_… / pk_live_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51TdbRmGCz9bK6BWhpKK4CKvmtEAHmgObXuzYDXlKKWSipkrhESR9jhUDHPWRIcuTrV88MaJTZTyzJ9HehJUMWZuQ00djhW6SZc
# Secret key (server only — never commit live keys): sk_test_… / sk_live_…
STRIPE_SECRET_KEY=sk_test_51TdbRmGCz9bK6BWhOx11jrrMK7J9BaaIhfipOLPe1AmcS7EFelu32L3O8ZfMuVSYpv0gGcha0ju71KPbVpEBkE6m008GtRjRgw
# Webhooks → Add endpoint → https://<your-domain>/api/v1/webhooks/stripe
# Events: payment_intent.amount_capturable_updated, payment_intent.succeeded,
#         payment_intent.payment_failed, payment_intent.canceled, charge.refunded
# Local dev: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Stays checkout pricing (Stripe gross-up; mirrors flight env pattern).
STAYS_COMMISSION_PERCENT=5
STAYS_MARKUP_FIXED=0
# Assumed Stripe card fee for gross-up (tune per dashboard).
STRIPE_FEE_RATE=0.029
# Max drift between payment snapshot and refreshed Duffel quote (major units).
STAYS_PRICE_TOLERANCE_MAJOR=1

# Shared secret for internal ops cron handlers (orphan PIT sweeper, refund poller, cancellation quote
# expirer). Required in production. Generate with: openssl rand -hex 32
# Caller MUST send: Authorization: Bearer <OPS_JOB_TOKEN>
OPS_JOB_TOKEN=8a91416dc0226a6d7892b302211f9ee888c3caacdfd92394790a69babf40c1b1
# When OPS_JOB_TOKEN is empty AND NODE_ENV !== production, set this to "1" to allow unauthenticated
# local invocation (e.g. for testing crons via curl).
OPS_JOB_TOKEN_DEV_BYPASS=0
# Vercel crons in vercel.json (daily, staggered UTC — Hobby plan limit). Set OPS_JOB_TOKEN in production.
# poll-refunds 00:00 | expire-cancellation-quotes 06:00 | expire-order-change-quotes 12:00 | sweep-orphan-pit 18:00
# For sub-daily schedules (e.g. poll every 15m), use Vercel Pro or an external scheduler hitting these POST routes.
# Auto-refund orphan succeeded PITs with no booking (default off; enable after UAT).
FLIGHT_ORPHAN_PIT_AUTO_REFUND=

# Server log level: debug | info | warn | error. Default: info in production, debug otherwise.
LOG_LEVEL=info
