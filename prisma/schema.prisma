// TravelTourUp — Prisma + Supabase PostgreSQL
//
// Connection URLs (Prisma ORM 7+): set in prisma.config.ts at repo root (DIRECT_URL / DATABASE_URL for Migrate), not here.
// Runtime PrismaClient uses DATABASE_URL via @prisma/adapter-pg — see src/lib/prisma.ts.
//
// Users & identity
// - Supabase stores credentials and identity in auth.users (not modeled here).
// - public.users (Prisma: User) is one app-owned row per auth user; User.id equals auth.users.id (UUID).
// - Distinct from auth.users: this table holds app profile + relations (bookings, roles, etc.).
//
// RBAC (data-driven)
// - Catalog: roles, permissions. Join: role_permissions (role ↔ permission), user_roles (user ↔ role).
// - user_permission_grants: optional direct permission rows for a user (exceptions), unioned with role-derived permissions.
// - Effective permissions for a user = ∪ permissions from all assigned roles ∪ user_permission_grants.
// - Resolution in app: see src/lib/authz/server.ts (e.g. getAuthzContextForUserId).

generator client {
  provider      = "prisma-client-js"
  /// App-local output so `PrismaClient` always matches `schema.prisma` (fixes IDE resolving a stale `@prisma/client`).
  output        = "../src/generated/prisma"
  /// Library engine is smaller and faster than the default binary engine — critical for serverless.
  engineType    = "library"
  /// Native = current OS (dev); rhel target = Vercel Amazon Linux 2023 runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

/// Stable string id (slug), e.g. admin | supplier | agent | customer | custom-vendor-1
model Role {
  id          String   @id
  name        String
  description String?  @db.Text
  is_system   Boolean  @default(false) @map("is_system")
  sort_order  Int      @default(0) @map("sort_order")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

/// Stable id slug, e.g. bookings:read_own — also unique on (resource, action)
model Permission {
  id          String   @id
  resource    String
  action      String
  description String?  @db.Text
  category    String?  @map("category")
  is_system   Boolean  @default(false) @map("is_system")
  created_at  DateTime @default(now()) @map("created_at")

  role_permissions RolePermission[]
  user_grants      UserPermissionGrant[]

  @@unique([resource, action])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  role_id       String @map("role_id")
  permission_id String @map("permission_id")

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

/// Many-to-many: users can hold multiple roles; effective permissions = union(role permissions) ∪ user grants.
model UserRole {
  user_id    String   @map("user_id") @db.Uuid
  role_id    String   @map("role_id")
  is_primary Boolean  @default(false) @map("is_primary")
  created_at DateTime @default(now()) @map("created_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@map("user_roles")
}

/// Additive permission grants for a user (not tied to a role). Use for exceptions / temporary access.
model UserPermissionGrant {
  user_id       String   @map("user_id") @db.Uuid
  permission_id String   @map("permission_id")
  created_at    DateTime @default(now()) @map("created_at")

  user       User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission  @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([user_id, permission_id])
  @@index([user_id])
  @@map("user_permission_grants")
}

/// Application user row; id mirrors Supabase auth.users.id (UUID).
model User {
  id                 String   @id @db.Uuid
  first_name         String   @map("first_name")
  last_name          String   @map("last_name")
  phone              String?
  phone_country_code String?  @map("phone_country_code")
  phone_e164         String?  @unique @map("phone_e164") @db.VarChar(20)
  phone_verified_at  DateTime? @map("phone_verified_at")
  phone_verify_required Boolean @default(false) @map("phone_verify_required")
  country_code       String?  @map("country_code") @db.Char(3)
  currency_id        String   @default("USD") @map("currency_id") @db.VarChar(3)
  /// Path inside Storage bucket `user-uploads` (e.g. `{userId}/avatar`). Private; use signed URL to view.
  avatar_path        String?  @map("avatar_path") @db.Text
  created_at         DateTime @default(now()) @map("created_at")
  updated_at         DateTime @updatedAt @map("updated_at")

  user_roles               UserRole[]
  permission_grants        UserPermissionGrant[]
  bookings                 Booking[]
  blog_posts               BlogPost[]
  flight_search_sessions   FlightSearchSession[]
  checkout_payment_records CheckoutPaymentRecord[]
  journey_events           CustomerJourneyEvent[]
  product_interests        CustomerProductInterest[]

  @@map("users")
}

model Booking {
  id             String   @id @default(cuid())
  booking_ref_no String   @unique @map("booking_ref_no")
  user_id        String?  @map("user_id") @db.Uuid
  type           String
  status         String
  payment_status String   @map("payment_status")
  total_amount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  currency       String   @db.VarChar(3)
  guest_data     Json?    @map("guest_data")
  /// Optional client idempotency for flight checkout (`POST /api/v1/flights/bookings`).
  idempotency_key String? @unique @map("idempotency_key")
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  user                 User?                       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  flightBooking        FlightBooking?
  hotelBooking         HotelBooking?
  carBooking           CarBooking?
  flightPaymentIntents FlightPaymentIntentRecord[]
  flightPaymentRefundAttempts FlightPaymentRefundAttempt[]
  checkoutPaymentRecords CheckoutPaymentRecord[]
  paymentRefundAttempts PaymentRefundAttempt[]
  financialEvents      BookingFinancialEvent[]
  converted_from_interests CustomerProductInterest[]

  @@index([user_id, created_at])
  @@map("bookings")
}

/// Append-only customer funnel events (detail → checkout → payment → booking).
model CustomerJourneyEvent {
  id              String   @id @default(cuid())
  user_id         String   @map("user_id") @db.Uuid
  event_type      String   @map("event_type") @db.VarChar(64)
  product_type    String   @map("product_type") @db.VarChar(16)
  product_ref     String   @map("product_ref") @db.VarChar(512)
  trip_unit_key   String?  @map("trip_unit_key") @db.VarChar(512)
  funnel_stage    String   @map("funnel_stage") @db.VarChar(32)
  properties      Json?
  client_event_id String?  @map("client_event_id") @db.VarChar(64)
  created_at      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, client_event_id])
  @@index([user_id, created_at])
  @@index([product_type, product_ref])
  @@index([user_id, trip_unit_key, created_at])
  @@index([funnel_stage, created_at])
  @@map("customer_journey_events")
}

/// Latest funnel stage per user × product — fast admin abandonment queries.
model CustomerProductInterest {
  id                    String    @id @default(cuid())
  user_id               String    @map("user_id") @db.Uuid
  product_type          String    @map("product_type") @db.VarChar(16)
  product_ref           String    @map("product_ref") @db.VarChar(512)
  trip_unit_key         String    @map("trip_unit_key") @db.VarChar(512)
  funnel_stage          String    @map("funnel_stage") @db.VarChar(32)
  title                 String?   @db.Text
  subtitle              String?   @db.Text
  price_amount          String?   @map("price_amount") @db.VarChar(24)
  price_currency        String?   @map("price_currency") @db.VarChar(3)
  origin_label          String?   @map("origin_label") @db.VarChar(128)
  destination_label     String?   @map("destination_label") @db.VarChar(128)
  start_date            String?   @map("start_date") @db.VarChar(10)
  end_date              String?   @map("end_date") @db.VarChar(10)
  travelers_summary     String?   @map("travelers_summary") @db.VarChar(128)
  trip_type             String?   @map("trip_type") @db.VarChar(16)
  search_context        Json?     @map("search_context")
  first_seen_at         DateTime  @default(now()) @map("first_seen_at")
  last_seen_at          DateTime  @default(now()) @map("last_seen_at")
  last_event_type       String?   @map("last_event_type") @db.VarChar(64)
  converted_booking_id  String?   @map("converted_booking_id")
  abandoned_at          DateTime? @map("abandoned_at")

  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  converted_booking  Booking? @relation(fields: [converted_booking_id], references: [id], onDelete: SetNull)

  @@unique([user_id, product_type, trip_unit_key])
  @@index([user_id, last_seen_at])
  @@index([product_type, product_ref])
  @@index([funnel_stage, last_seen_at])
  @@index([funnel_stage, start_date])
  @@index([destination_label, last_seen_at])
  @@index([converted_booking_id])
  @@map("customer_product_interests")
}

/// Append-only money-moving event log for support, reconciliation, and the
/// customer "money timeline" UI. Never updated — write a new row per event.
model BookingFinancialEvent {
  id                              String   @id @default(cuid())
  booking_id                      String?  @map("booking_id")
  flight_payment_intent_record_id String?  @map("flight_payment_intent_record_id")
  /// See `BOOKING_FINANCIAL_EVENT_TYPES` in src/lib/constants/booking-states.ts.
  type                            String   @map("type") @db.VarChar(40)
  amount                          String?  @map("amount") @db.VarChar(24)
  currency                        String?  @map("currency") @db.VarChar(3)
  /// Free-form context (Duffel ids, error codes, refund ids, change ids, etc.).
  payload                         Json?    @map("payload")
  /// Optional correlation id for tracing across HTTP + webhooks + cron.
  request_id                      String?  @map("request_id") @db.VarChar(64)
  checkout_payment_record_id      String?  @map("checkout_payment_record_id")
  created_at                      DateTime @default(now()) @map("created_at")

  booking                   Booking?                   @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  flightPaymentIntentRecord FlightPaymentIntentRecord? @relation(fields: [flight_payment_intent_record_id], references: [id], onDelete: SetNull)
  checkoutPaymentRecord     CheckoutPaymentRecord?     @relation(fields: [checkout_payment_record_id], references: [id], onDelete: SetNull)

  @@index([booking_id, created_at])
  @@index([flight_payment_intent_record_id, created_at])
  @@index([checkout_payment_record_id, created_at])
  @@index([type, created_at])
  @@map("booking_financial_events")
}

model FlightBooking {
  id         String   @id @default(cuid())
  booking_id String   @unique @map("booking_id")
  payload    Json?

  duffel_order_id             String?   @unique @map("duffel_order_id")
  duffel_offer_id             String?   @map("duffel_offer_id")
  duffel_offer_request_id     String?   @map("duffel_offer_request_id")
  booking_reference           String?   @map("booking_reference")
  live_mode                   Boolean?  @map("live_mode")
  last_offer_total_amount     Decimal?  @map("last_offer_total_amount") @db.Decimal(14, 2)
  last_offer_total_currency   String?   @map("last_offer_total_currency") @db.VarChar(3)
  offer_expires_at            DateTime? @map("offer_expires_at")
  itinerary_snapshot          Json?     @map("itinerary_snapshot")
  order_raw                   Json?     @map("order_raw")
  /// Supabase Storage object key (private `flight-tickets` bucket) for generated itinerary PDF.
  ticket_pdf_storage_path      String?   @map("ticket_pdf_storage_path") @db.VarChar(512)
  ticket_pdf_generated_at      DateTime? @map("ticket_pdf_generated_at")
  ticket_pdf_generation_failed_at DateTime? @map("ticket_pdf_generation_failed_at")
  ticket_pdf_error             String?   @map("ticket_pdf_error") @db.VarChar(500)

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  ancillaries BookingAncillary[]
  orderCancellations FlightOrderCancellation[]
  orderChanges FlightOrderChange[]

  @@map("flight_bookings")
}

/**
 * Voluntary order change (exchange) — quote then confirm per Duffel
 * `order_change_requests` → `order_changes` flow. We also persist
 * airline-initiated schedule changes here with `source = 'airline'`. Payment
 * for positive deltas reuses the existing PaymentIntent saga; the
 * `flight_payment_intent_record_id` column links the (optional) intent.
 */
model FlightOrderChange {
  id                              String   @id @default(cuid())
  flight_booking_id               String   @map("flight_booking_id")
  /// 'user' (voluntary) or 'airline' (involuntary / schedule change).
  source                          String   @default("user") @map("source") @db.VarChar(16)
  duffel_order_change_request_id  String?  @map("duffel_order_change_request_id") @db.VarChar(64)
  duffel_order_change_id          String?  @map("duffel_order_change_id") @db.VarChar(64)
  /// Quoted price delta (positive when customer pays more, negative when refunded).
  change_amount                   String?  @map("change_amount") @db.VarChar(24)
  change_currency                 String?  @map("change_currency") @db.VarChar(3)
  /// `pending` | `quoted` | `pending_payment` | `confirmed` | `expired` | `cancelled` | `failed`.
  status                          String   @map("status") @db.VarChar(24)
  /// Optional link to the PaymentIntent used to pay the positive delta.
  flight_payment_intent_record_id String?  @map("flight_payment_intent_record_id")
  quote_expires_at                DateTime? @map("quote_expires_at")
  confirmed_at                    DateTime? @map("confirmed_at")
  raw                             Json?    @map("raw")
  created_at                      DateTime @default(now()) @map("created_at")
  updated_at                      DateTime @updatedAt @map("updated_at")

  flightBooking             FlightBooking              @relation(fields: [flight_booking_id], references: [id], onDelete: Cascade)
  flightPaymentIntentRecord FlightPaymentIntentRecord? @relation("FlightOrderChangePaymentIntent", fields: [flight_payment_intent_record_id], references: [id], onDelete: SetNull)

  @@unique([duffel_order_change_request_id])
  @@unique([duffel_order_change_id])
  @@index([flight_booking_id])
  @@index([status, quote_expires_at])
  @@map("flight_order_changes")
}

/// Duffel order cancellation (`ore_*`) — quote then confirm per Duffel API.
model FlightOrderCancellation {
  id                     String    @id @default(cuid())
  flight_booking_id      String    @map("flight_booking_id")
  duffel_cancellation_id String    @unique @map("duffel_cancellation_id") @db.VarChar(64)
  duffel_order_id        String    @map("duffel_order_id") @db.VarChar(64)
  status                 String    @map("status") @db.VarChar(24)
  refund_amount          String?   @map("refund_amount") @db.VarChar(24)
  refund_currency        String?   @map("refund_currency") @db.VarChar(3)
  refund_to              String?   @map("refund_to") @db.VarChar(40)
  quote_expires_at       DateTime? @map("quote_expires_at")
  confirmed_at           DateTime? @map("confirmed_at")
  raw                    Json?     @map("raw")
  created_at             DateTime  @default(now()) @map("created_at")
  updated_at             DateTime  @updatedAt @map("updated_at")

  flightBooking FlightBooking @relation(fields: [flight_booking_id], references: [id], onDelete: Cascade)
  refundAttempt   FlightPaymentRefundAttempt?

  @@index([flight_booking_id])
  @@index([duffel_order_id])
  @@index([status, quote_expires_at])
  @@map("flight_order_cancellations")
}

/// One card refund attempt per Duffel order cancellation (`POST /payments/refunds`).
model FlightPaymentRefundAttempt {
  id                            String   @id @default(cuid())
  booking_id                    String   @map("booking_id")
  flight_order_cancellation_id  String   @unique @map("flight_order_cancellation_id")
  flight_payment_intent_record_id String? @map("flight_payment_intent_record_id")
  provider                      String   @default("duffel_payments") @map("provider") @db.VarChar(24)
  duffel_refund_id              String?  @unique @map("duffel_refund_id") @db.VarChar(64)
  amount                        String?  @map("amount") @db.VarChar(24)
  currency                      String?  @map("currency") @db.VarChar(3)
  status                        String   @map("status") @db.VarChar(24)
  error_code                    String?  @map("error_code") @db.VarChar(120)
  raw                           Json?    @map("raw")
  created_at                    DateTime @default(now()) @map("created_at")
  updated_at                    DateTime @updatedAt @map("updated_at")

  booking                   Booking                 @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  flightOrderCancellation   FlightOrderCancellation @relation(fields: [flight_order_cancellation_id], references: [id], onDelete: Cascade)
  flightPaymentIntentRecord FlightPaymentIntentRecord? @relation(fields: [flight_payment_intent_record_id], references: [id], onDelete: SetNull)

  @@index([booking_id])
  @@index([status, updated_at])
  @@map("flight_payment_refund_attempts")
}

/// Confirmed ancillaries from Duffel order (seats, bags, etc.).
model BookingAncillary {
  id               String   @id @default(cuid())
  flight_booking_id String  @map("flight_booking_id")
  type             String   @map("type") @db.VarChar(32)
  duffel_service_id String? @map("duffel_service_id") @db.VarChar(64)
  passenger_id     String?  @map("passenger_id") @db.VarChar(64)
  segment_id       String?  @map("segment_id") @db.VarChar(64)
  amount           String?  @map("amount") @db.VarChar(24)
  currency         String?  @map("currency") @db.VarChar(3)
  status           String?  @map("status") @db.VarChar(32)
  raw              Json?    @map("raw")
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")

  flightBooking FlightBooking @relation(fields: [flight_booking_id], references: [id], onDelete: Cascade)

  @@index([flight_booking_id])
  @@map("booking_ancillaries")
}

model FlightSearchSession {
  id               String   @id @default(cuid())
  user_id          String?  @map("user_id") @db.Uuid
  offer_request_id String   @map("offer_request_id")
  params_hash      String   @map("params_hash")
  params_json      Json     @map("params_json")
  expires_at       DateTime @map("expires_at")
  created_at       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([params_hash])
  @@index([user_id])
  @@map("flight_search_sessions")
}

/// Duffel Payment Intents for flight checkout (P2). Server-side idempotency and confirm gate.
model FlightPaymentIntentRecord {
  id               String  @id @default(cuid())
  duffel_intent_id String  @unique @map("duffel_intent_id")
  offer_id         String  @map("offer_id")
  charge_amount    String  @map("charge_amount") @db.VarChar(24)
  charge_currency  String  @map("charge_currency") @db.VarChar(3)
  offer_amount     String  @map("offer_amount") @db.VarChar(24)
  offer_currency   String  @map("offer_currency") @db.VarChar(3)
  markup_amount    String  @map("markup_amount") @db.VarChar(24)
  /// Customer subtotal before Duffel Payments fee gross-up (immutable at PIT create).
  subtotal_charged_amount      String? @map("subtotal_charged_amount") @db.VarChar(24)
  /// `charge_amount − subtotal_charged_amount` at PIT create.
  duffel_payments_fee_amount   String? @map("duffel_payments_fee_amount") @db.VarChar(24)
  duffel_payments_fee_rate     String? @map("duffel_payments_fee_rate") @db.VarChar(16)
  fx_rate_applied              String? @map("fx_rate_applied") @db.VarChar(16)
  commission_percent_applied   String? @map("commission_percent_applied") @db.VarChar(16)
  markup_fixed_applied         String? @map("markup_fixed_applied") @db.VarChar(24)
  applied_pricing_rule_id      String? @map("applied_pricing_rule_id") @db.VarChar(64)
  /// Duffel-reported fee after capture (reconciliation).
  duffel_reported_fees_amount  String? @map("duffel_reported_fees_amount") @db.VarChar(24)
  duffel_reported_net_amount   String? @map("duffel_reported_net_amount") @db.VarChar(24)
  /// Sum of selected ancillary service amounts in `offer_currency` (Duffel major units).
  services_subtotal_amount String? @map("services_subtotal_amount") @db.VarChar(24)
  /// Snapshot of `{ id, quantity }[]` sent to Duffel `POST /air/orders` `services`.
  ancillary_selection      Json?   @map("ancillary_selection")
  status           String  @map("status") @db.VarChar(32)
  client_token     String  @map("client_token") @db.Text
  idempotency_key  String? @unique @map("idempotency_key")
  booking_id       String? @map("booking_id")
  /// Set when `POST /air/orders` failed after payment; used for idempotent error replay.
  order_failure_at                        DateTime? @map("order_failure_at")
  order_failure_booking_idempotency_key   String?   @unique @map("order_failure_booking_idempotency_key")
  order_failure_code                      String?   @map("order_failure_code") @db.VarChar(64)
  order_failure_refund_id                 String?   @map("order_failure_refund_id") @db.VarChar(64)
  order_failure_refund_status             String?   @map("order_failure_refund_status") @db.VarChar(32)

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  refundAttempts FlightPaymentRefundAttempt[]
  financialEvents BookingFinancialEvent[]
  orderChanges FlightOrderChange[] @relation("FlightOrderChangePaymentIntent")

  @@index([booking_id])
  @@index([status, updated_at])
  @@index([order_failure_refund_id])
  @@map("flight_payment_intent_records")
}

/**
 * Per-route / cabin / carrier pricing overrides on top of the env-driven
 * `FlightPaymentsConfig`. Highest-priority matching enabled rule wins; caps
 * are always enforced after resolution. Strings throughout to avoid drift
 * with the existing `String` monetary columns; resolver casts to Number.
 */
model FlightPricingRule {
  id                           String   @id @default(cuid())
  name                         String
  enabled                      Boolean  @default(true)
  /// Lower wins. Use 100 as the default priority.
  priority                     Int      @default(100)
  origin_iata                  String?  @map("origin_iata") @db.VarChar(8)
  destination_iata             String?  @map("destination_iata") @db.VarChar(8)
  carrier_iata                 String?  @map("carrier_iata") @db.VarChar(8)
  /// 'economy' | 'premium_economy' | 'business' | 'first'.
  cabin_class                  String?  @map("cabin_class") @db.VarChar(24)
  /// Override commission percent (0–100). Null = use env config default.
  commission_percent_override  Decimal? @map("commission_percent_override") @db.Decimal(6, 3)
  /// Override fixed markup in offer currency, major units. Null = use env default.
  markup_fixed_override        String?  @map("markup_fixed_override") @db.VarChar(24)
  /// Hard cap (percent) applied after override. Null = no cap beyond resolved value.
  max_commission_percent       Decimal? @map("max_commission_percent") @db.Decimal(6, 3)
  /// Hard cap (fixed, major units). Null = no cap.
  max_markup_fixed             String?  @map("max_markup_fixed") @db.VarChar(24)
  /// Optional effective window.
  effective_from               DateTime? @map("effective_from")
  effective_to                 DateTime? @map("effective_to")
  notes                        String?  @db.Text
  created_at                   DateTime @default(now()) @map("created_at")
  updated_at                   DateTime @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@index([origin_iata, destination_iata])
  @@map("flight_pricing_rules")
}

model DuffelWebhookEvent {
  id           String    @id @default(cuid())
  event_id     String    @unique @map("event_id")
  type         String
  payload      Json
  received_at  DateTime  @default(now()) @map("received_at")
  processed_at DateTime? @map("processed_at")
  error        String?   @db.Text

  @@map("duffel_webhook_events")
}

/// Stripe (or future PSP) checkout payment records for hotels/cars.
model CheckoutPaymentRecord {
  id                         String   @id @default(cuid())
  product_type               String   @map("product_type") @db.VarChar(16)
  provider                   String   @default("stripe") @map("provider") @db.VarChar(24)
  provider_intent_id         String   @unique @map("provider_intent_id") @db.VarChar(64)
  supplier_ref_id            String   @map("supplier_ref_id") @db.VarChar(128)
  user_id                    String   @map("user_id") @db.Uuid
  supplier_amount            String   @map("supplier_amount") @db.VarChar(24)
  supplier_currency          String   @map("supplier_currency") @db.VarChar(3)
  markup_amount              String   @map("markup_amount") @db.VarChar(24)
  commission_percent_applied String?  @map("commission_percent_applied") @db.VarChar(16)
  markup_fixed_applied       String?  @map("markup_fixed_applied") @db.VarChar(24)
  charge_amount              String   @map("charge_amount") @db.VarChar(24)
  charge_currency            String   @map("charge_currency") @db.VarChar(3)
  customer_currency_requested String? @map("customer_currency_requested") @db.VarChar(3)
  charge_currency_fallback   Boolean  @default(false) @map("charge_currency_fallback")
  fx_rate_applied            String?  @map("fx_rate_applied") @db.VarChar(24)
  fx_snapshot_json           Json?    @map("fx_snapshot_json")
  stripe_fee_rate            String?  @map("stripe_fee_rate") @db.VarChar(16)
  client_secret              String   @map("client_secret") @db.Text
  status                     String   @map("status") @db.VarChar(32)
  booking_id                 String?  @map("booking_id")
  idempotency_key            String?  @unique @map("idempotency_key")
  quote_expires_at           DateTime? @map("quote_expires_at")
  order_failure_at                        DateTime? @map("order_failure_at")
  order_failure_booking_idempotency_key   String?   @unique @map("order_failure_booking_idempotency_key")
  order_failure_code                      String?   @map("order_failure_code") @db.VarChar(64)
  order_failure_refund_id                 String?   @map("order_failure_refund_id") @db.VarChar(64)
  order_failure_refund_status             String?   @map("order_failure_refund_status") @db.VarChar(32)
  created_at                 DateTime @default(now()) @map("created_at")
  updated_at                 DateTime @updatedAt @map("updated_at")

  user              User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  booking           Booking?                  @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  financialEvents   BookingFinancialEvent[]
  refundAttempts    PaymentRefundAttempt[]
  staysCancellation StaysBookingCancellation?

  @@index([booking_id])
  @@index([user_id, created_at])
  @@index([status, updated_at])
  @@index([supplier_ref_id])
  @@map("checkout_payment_records")
}

/// Duffel stays booking cancellation audit row.
model StaysBookingCancellation {
  id                         String    @id @default(cuid())
  hotel_booking_id           String    @map("hotel_booking_id")
  checkout_payment_record_id String?   @unique @map("checkout_payment_record_id")
  duffel_booking_id          String    @map("duffel_booking_id") @db.VarChar(64)
  status                     String    @map("status") @db.VarChar(24)
  refund_amount              String?   @map("refund_amount") @db.VarChar(24)
  refund_currency            String?   @map("refund_currency") @db.VarChar(3)
  customer_refund_amount     String?   @map("customer_refund_amount") @db.VarChar(24)
  customer_refund_currency   String?   @map("customer_refund_currency") @db.VarChar(3)
  confirmed_at               DateTime? @map("confirmed_at")
  raw                        Json?     @map("raw")
  created_at                 DateTime  @default(now()) @map("created_at")
  updated_at                 DateTime  @updatedAt @map("updated_at")

  hotelBooking           HotelBooking           @relation(fields: [hotel_booking_id], references: [id], onDelete: Cascade)
  checkoutPaymentRecord  CheckoutPaymentRecord? @relation(fields: [checkout_payment_record_id], references: [id], onDelete: SetNull)
  refundAttempt          PaymentRefundAttempt?

  @@index([hotel_booking_id])
  @@index([duffel_booking_id])
  @@map("stays_booking_cancellations")
}

/// Generic PSP refund attempt (Stripe for stays/cars).
model PaymentRefundAttempt {
  id                         String   @id @default(cuid())
  booking_id                 String   @map("booking_id")
  checkout_payment_record_id String?  @map("checkout_payment_record_id")
  stays_cancellation_id      String?  @unique @map("stays_cancellation_id")
  provider                   String   @default("stripe") @map("provider") @db.VarChar(24)
  provider_refund_id         String?  @unique @map("provider_refund_id") @db.VarChar(64)
  amount                     String?  @map("amount") @db.VarChar(24)
  currency                   String?  @map("currency") @db.VarChar(3)
  status                     String   @map("status") @db.VarChar(24)
  error_code                 String?  @map("error_code") @db.VarChar(120)
  raw                        Json?    @map("raw")
  created_at                 DateTime @default(now()) @map("created_at")
  updated_at                 DateTime @updatedAt @map("updated_at")

  booking                 Booking                  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  checkoutPaymentRecord   CheckoutPaymentRecord?   @relation(fields: [checkout_payment_record_id], references: [id], onDelete: SetNull)
  staysCancellation       StaysBookingCancellation? @relation(fields: [stays_cancellation_id], references: [id], onDelete: SetNull)

  @@index([booking_id])
  @@index([status, updated_at])
  @@map("payment_refund_attempts")
}

model HotelBooking {
  id         String   @id @default(cuid())
  booking_id String   @unique @map("booking_id")
  payload    Json?

  duffel_booking_id         String?   @unique @map("duffel_booking_id") @db.VarChar(64)
  duffel_quote_id           String?   @map("duffel_quote_id") @db.VarChar(64)
  stays_search_result_id    String?   @map("stays_search_result_id") @db.VarChar(64)
  duffel_accommodation_id   String?   @map("duffel_accommodation_id") @db.VarChar(64)
  booking_reference         String?   @map("booking_reference") @db.VarChar(64)
  quote_expires_at          DateTime? @map("quote_expires_at")
  accommodation_snapshot    Json?     @map("accommodation_snapshot")
  stays_raw                 Json?     @map("stays_raw")

  confirmation_pdf_storage_path           String?   @map("confirmation_pdf_storage_path") @db.VarChar(512)
  confirmation_pdf_generated_at           DateTime? @map("confirmation_pdf_generated_at")
  confirmation_pdf_generation_failed_at     DateTime? @map("confirmation_pdf_generation_failed_at")
  confirmation_pdf_error                  String?   @map("confirmation_pdf_error") @db.VarChar(500)

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  cancellations StaysBookingCancellation[]

  @@index([duffel_accommodation_id])
  @@map("hotel_bookings")
}

model CarBooking {
  id         String   @id @default(cuid())
  booking_id String   @unique @map("booking_id")
  payload    Json?
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("car_bookings")
}

model AdminHotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  stars       Int?
  location    String?
  address     String?  @db.Text
  currency    String   @db.VarChar(3)
  amenities   Json?
  policy      String?  @db.Text
  status      String   @default("active")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@map("admin_hotels")
}

model AdminCar {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  passengers    Int?
  transmission  String?
  price_per_day Decimal  @map("price_per_day") @db.Decimal(12, 2)
  currency      String   @db.VarChar(3)
  airport_code  String?  @map("airport_code") @db.VarChar(3)
  status        String   @default("active")
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")

  @@map("admin_cars")
}

model BlogCategory {
  id         String   @id @default(cuid())
  slug       String   @unique
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  posts        BlogPost[]
  translations BlogCategoryTranslation[]

  @@map("blog_categories")
}

model BlogCategoryTranslation {
  id          String   @id @default(cuid())
  category_id String   @map("category_id")
  locale      String   @db.VarChar(8)
  name        String
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  category BlogCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, locale])
  @@index([locale])
  @@map("blog_category_translations")
}

model BlogPost {
  id           String    @id @default(cuid())
  tags         String[]  @default([])
  status       String    @default("draft")
  featured     Boolean   @default(false)
  views_count  Int       @default(0) @map("views_count")
  read_time    Int       @default(0) @map("read_time")
  robots_meta  String?   @default("index,follow") @map("robots_meta")
  published_at DateTime? @map("published_at")
  created_at   DateTime  @default(now()) @map("created_at")
  updated_at   DateTime  @updatedAt @map("updated_at")

  category_id String       @map("category_id")
  category    BlogCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)

  author_id String? @map("author_id") @db.Uuid
  author    User?   @relation(fields: [author_id], references: [id], onDelete: SetNull)

  images       BlogPostImage[]
  translations BlogPostTranslation[]

  @@index([status, published_at])
  @@index([category_id])
  @@index([updated_at])
  @@index([robots_meta])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id               String   @id @default(cuid())
  blog_post_id     String   @map("blog_post_id")
  locale           String   @db.VarChar(8)
  title            String
  slug             String
  content          String   @db.Text
  excerpt          String   @db.Text
  meta_title       String?  @map("meta_title") @db.Text
  meta_description String?  @map("meta_description") @db.Text
  focus_keyphrase  String?  @map("focus_keyphrase") @db.Text
  canonical_url    String?  @map("canonical_url") @db.Text
  /// Map of `BlogPostImage.id` → localized alt text.
  image_alts       Json     @default("{}") @map("image_alts")
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")

  blog_post BlogPost @relation(fields: [blog_post_id], references: [id], onDelete: Cascade)

  @@unique([blog_post_id, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("blog_post_translations")
}

/// Gallery images for a blog post; exactly one per post should have `is_featured` (card / OG hero).
/// DB: partial unique index `blog_post_images_one_featured_per_post` is defined in migrations (Prisma cannot model WHERE ... yet).
model BlogPostImage {
  id           String   @id @default(cuid())
  blog_post_id String   @map("blog_post_id")
  url          String   @db.Text
  sort_order   Int      @default(0) @map("sort_order")
  is_featured  Boolean  @default(false) @map("is_featured")
  /// Optional Supabase `blogs_images` object key for admin storage cleanup.
  storage_path String?  @map("storage_path") @db.Text
  created_at   DateTime @default(now()) @map("created_at")

  blog_post BlogPost @relation(fields: [blog_post_id], references: [id], onDelete: Cascade)

  @@index([blog_post_id])
  @@map("blog_post_images")
}
